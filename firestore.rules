rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isCollegeGoogleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.matches('^[^@]+@sjec[.]ac[.]in$');
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'superadmin@agentblazer.club';
    }

    match /chat_messages/{messageId} {
      allow read, create: if isCollegeGoogleUser() || isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /bulletin_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Presence: each signed-in user can write their own doc; anyone signed in can read all
    match /presence/{userId} {
      allow read: if isCollegeGoogleUser() || isAdmin();
      allow write: if (isCollegeGoogleUser() || isAdmin()) && request.auth.uid == userId;
    }
  }
}

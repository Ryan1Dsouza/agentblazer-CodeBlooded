rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isCollegeGoogleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.matches('^[^@]+@sjec[.]ac[.]in$');
    }

    match /chat_messages/{messageId} {
      allow read, create: if isCollegeGoogleUser();
      allow update: if false;
      allow delete: if isCollegeGoogleUser();
    }

    // Presence: each signed-in user can write their own doc; anyone signed in can read all
    match /presence/{userId} {
      allow read: if isCollegeGoogleUser();
      allow write: if isCollegeGoogleUser() && request.auth.uid == userId;
    }
  }
}
